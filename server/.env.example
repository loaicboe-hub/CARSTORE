# Server Port
PORT=5001

# PostgreSQL Connection String
# Examples:
# Local / Docker: postgresql://postgres:postgrespassword@localhost:5432/carstore_db
# Supabase: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Neon: postgresql://[USER]:[PASSWORD]@[HOST]/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/carstore_db

# Frontend Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
